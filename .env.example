# ==============================================================================
# Apartment Visit Management System (AVMS) - Environment Configuration Template
# Copy this file to '.env' and update variables for your target deployment.
# ==============================================================================

# Application Secret Key for session signing & CSRF protection
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production

# Application Environment ('development', 'testing', 'production')
FLASK_CONFIG=development

# Port to bind (default 5000)
PORT=5000

# Database Engine Selection:
# Option 1 (Default zero-config): 'sqlite'
DB_ENGINE=sqlite
DATABASE_PATH=instance/avms.db

# Option 2: 'mysql' (Enterprise/MariaDB compatibility)
# DB_ENGINE=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DB=avmsdb

# Cookie Security (Enable True for HTTPS production environments)
SESSION_COOKIE_SECURE=False
